      "type": "stat",
      "targets": [
        {
          "expr": "http_errors_total",
          "legendFormat": "5xx Errors"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
