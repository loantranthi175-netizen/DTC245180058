      "id": 2,
      "title": "Tổng số Request Nginx xử lý",
      "type": "stat",
      "targets": [
        {
          "expr": "nginx_http_requests_total",
          "legendFormat": "Total Requests"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
