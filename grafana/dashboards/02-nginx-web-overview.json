      "title": "Quiz App Total Requests",
      "type": "stat",
      "targets": [
        {
          "expr": "http_requests_total",
          "legendFormat": "App Requests"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
