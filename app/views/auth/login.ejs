<%- include('../layouts/header', { title: 'Đăng nhập' }) %>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Đăng nhập Hệ thống</h2>
            <p>Nhập thông tin tài khoản của bạn để tiếp tục</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <form action="/login" method="POST" class="auth-form">
            <div class="form-group">
                <label for="email">Địa chỉ Email</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="admin@quiz.local" required autofocus>
            </div>

            <div class="form-group">
                <label for="password">Mật khẩu</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Đăng nhập</button>
        </form>

        <div class="quick-credentials">
            <p class="quick-title">⚡ Tài khoản mẫu có sẵn:</p>
            <div class="cred-box" onclick="fillCred('admin@quiz.local', 'Admin@123')">
                <strong>Admin:</strong> <code>admin@quiz.local</code> / <code>Admin@123</code>
                <span class="btn-copy">Dùng tài khoản này</span>
            </div>
            <div class="cred-box" onclick="fillCred('student@quiz.local', 'Student@123')">
                <strong>Thí sinh:</strong> <code>student@quiz.local</code> / <code>Student@123</code>
                <span class="btn-copy">Dùng tài khoản này</span>
            </div>
        </div>

        <div class="auth-footer">
            <p>Chưa có tài khoản? <a href="/register">Đăng ký ngay</a></p>
        </div>
    </div>
</div>

<script>
function fillCred(email, pass) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = pass;
}
</script>

<%- include('../layouts/footer') %>
