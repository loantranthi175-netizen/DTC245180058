<%- include('../layouts/header', { title: 'Tạo đề thi mới' }) %>

<div class="container container-sm">
    <div class="page-header">
        <a href="/admin" class="back-link">← Quay lại bảng điều khiển</a>
        <h2>➕ Tạo đề thi trắc nghiệm mới</h2>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="card">
        <div class="card-body">
            <form action="/admin/quizzes/create" method="POST">
                <div class="form-group">
                    <label for="title">Tên đề thi <span class="required">*</span></label>
                    <input type="text" id="title" name="title" class="form-control" placeholder="Ví dụ: Kiểm tra Kiến thức Nginx & Docker cơ bản" required>
                </div>

                <div class="form-group">
                    <label for="description">Mô tả bài thi</label>
                    <textarea id="description" name="description" rows="3" class="form-control" placeholder="Mô tả nội dung trọng tâm của đề thi, số lượng câu, mục tiêu..."></textarea>
                </div>

                <div class="form-group">
                    <label for="time_limit">Thời gian làm bài (phút)</label>
                    <input type="number" id="time_limit" name="time_limit" class="form-control" value="15" min="1" max="180" required>
                </div>

                <div class="form-actions">
                    <a href="/admin" class="btn btn-outline">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary">Lưu & Thêm câu hỏi →</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
