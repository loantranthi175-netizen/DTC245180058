<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Hệ thống Quiz Trắc nghiệm</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="navbar">
        <div class="nav-container">
            <a href="/" class="brand-logo">
                <span class="logo-icon">📝</span>
                <span class="logo-text">DevOps Quiz</span>
            </a>

            <nav class="nav-menu">
                <% if (user) { %>
                    <% if (user.role === 'admin') { %>
                        <a href="/admin" class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>">📊 Tổng quan</a>
                        <a href="/admin/users" class="nav-link <%= currentPath === '/admin/users' ? 'active' : '' %>">👥 Quản lý người dùng</a>
                        <a href="/admin/quizzes/create" class="nav-link <%= currentPath === '/admin/quizzes/create' ? 'active' : '' %>">➕ Tạo đề thi</a>
                    <% } else if (user.role === 'teacher') { %>
                        <a href="/admin" class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>">📚 Đề thi & Kết quả</a>
                        <a href="/admin/quizzes/create" class="nav-link <%= currentPath === '/admin/quizzes/create' ? 'active' : '' %>">➕ Tạo đề thi mới</a>
                    <% } else { %>
                        <a href="/quizzes" class="nav-link <%= currentPath === '/quizzes' ? 'active' : '' %>">📚 Đề thi</a>
                        <a href="/history" class="nav-link <%= currentPath === '/history' ? 'active' : '' %>">🕒 Lịch sử làm bài</a>
                    <% } %>
                    <a href="/health" target="_blank" class="nav-link health-badge" title="Kiểm tra trạng thái Service">🟢 Health</a>
                <% } %>
            </nav>

            <div class="user-menu">
                <% if (user) { %>
                    <div class="user-info">
                        <span class="user-name"><%= user.fullname %></span>
                        <% if (user.role === 'admin') { %>
                            <span class="role-badge role-admin">Quản trị viên</span>
                        <% } else if (user.role === 'teacher') { %>
                            <span class="role-badge role-teacher">Giáo viên</span>
                        <% } else { %>
                            <span class="role-badge role-candidate">Sinh viên</span>
                        <% } %>
                    </div>
                    <a href="/logout" class="btn btn-outline btn-sm">Đăng xuất</a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary btn-sm">Đăng nhập</a>
                    <a href="/register" class="btn btn-outline btn-sm">Đăng ký</a>
                <% } %>
            </div>
        </div>
    </header>

    <main class="main-content">
