<%- include('../layouts/header', { title: 'Làm bài thi: ' + quiz.title }) %>

<div class="quiz-take-wrapper">
    <!-- Sticky Header: Đề thi, Đồng hồ đếm ngược và Thanh tiến trình -->
    <div class="quiz-sticky-header">
        <div class="quiz-header-top">
            <div>
                <a href="/quizzes" class="back-link" style="font-size: 0.85rem; color: #64748b; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; margin-bottom: 0.3rem;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Quay lại danh sách đề thi</span>
                </a>
                <h1 class="quiz-title-main"><%= quiz.title %></h1>
                <p style="font-size: 0.85rem; color: #64748b; margin-top: 0.15rem;"><%= quiz.description || 'Bài thi trắc nghiệm trực tuyến chuẩn hóa.' %></p>
            </div>

            <!-- Widget đồng hồ đếm ngược Javascript với hiệu ứng học thuật -->
            <div class="quiz-timer-widget" id="timerWidget">
                <svg class="timer-clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <div style="display: flex; flex-direction: column;">
                    <span style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; font-weight: 700;">Thời gian còn lại</span>
                    <span class="timer-digits" id="timerDisplay"><%= quiz.time_limit %>:00</span>
                </div>
            </div>
        </div>

        <!-- Thanh tiến độ trả lời câu hỏi trực quan -->
        <div class="quiz-progress-section">
            <div class="progress-info-row">
                <span id="progressText">Tiến độ: 0 / <%= questions.length %> câu</span>
                <span id="progressPercent">0%</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" id="progressBar" style="width: 0%;"></div>
            </div>
        </div>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger" style="margin-top: 2rem;"><%= error %></div>
    <% } else { %>
        <form action="/quizzes/<%= quiz.id %>/submit" method="POST" id="quizForm">
            <div class="quiz-layout-grid">
                <!-- Cột chính: Danh sách câu hỏi trắc nghiệm -->
                <div class="questions-stream">
                    <% questions.forEach((q, index) => { %>
                        <div class="question-card-academic" id="q_card_<%= q.id %>">
                            <div class="question-header-bar">
                                <span class="q-badge-academic">Câu <%= String(index + 1).padStart(2, '0') %></span>
                                <span style="font-size: 0.8rem; color: #94a3b8; font-weight: 600;">(Chọn 1 đáp án đúng nhất)</span>
                            </div>

                            <div class="q-content-text">
                                <%= q.content %>
                            </div>

                            <div class="options-list-grid" style="margin-top: 1.25rem;">
                                <!-- Đáp án A -->
                                <label class="option-radio-card" id="opt_label_<%= q.id %>_A" onclick="selectOption('<%= q.id %>', 'A')">
                                    <input type="radio" name="q_<%= q.id %>" value="A" id="opt_input_<%= q.id %>_A">
                                    <span class="option-letter-badge">A</span>
                                    <span class="option-text-desc"><%= q.option_a %></span>
                                </label>

                                <!-- Đáp án B -->
                                <label class="option-radio-card" id="opt_label_<%= q.id %>_B" onclick="selectOption('<%= q.id %>', 'B')">
                                    <input type="radio" name="q_<%= q.id %>" value="B" id="opt_input_<%= q.id %>_B">
                                    <span class="option-letter-badge">B</span>
                                    <span class="option-text-desc"><%= q.option_b %></span>
                                </label>

                                <!-- Đáp án C -->
                                <label class="option-radio-card" id="opt_label_<%= q.id %>_C" onclick="selectOption('<%= q.id %>', 'C')">
                                    <input type="radio" name="q_<%= q.id %>" value="C" id="opt_input_<%= q.id %>_C">
                                    <span class="option-letter-badge">C</span>
                                    <span class="option-text-desc"><%= q.option_c %></span>
                                </label>

                                <!-- Đáp án D -->
                                <label class="option-radio-card" id="opt_label_<%= q.id %>_D" onclick="selectOption('<%= q.id %>', 'D')">
                                    <input type="radio" name="q_<%= q.id %>" value="D" id="opt_input_<%= q.id %>_D">
                                    <span class="option-letter-badge">D</span>
                                    <span class="option-text-desc"><%= q.option_d %></span>
                                </label>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Cột phụ: Bảng điều hướng câu hỏi nhanh (Question Palette) & Nút nộp bài -->
                <aside class="quiz-sidebar">
                    <div class="quiz-palette-card">
                        <div class="palette-title">
                            <span>Bảng câu hỏi</span>
                            <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;"><%= questions.length %> câu</span>
                        </div>

                        <div class="palette-grid">
                            <% questions.forEach((q, index) => { %>
                                <a href="javascript:void(0)" onclick="scrollToQuestion('<%= q.id %>')" class="palette-btn" id="palette_btn_<%= q.id %>">
                                    <%= index + 1 %>
                                </a>
                            <% }) %>
                        </div>

                        <div class="palette-legend">
                            <div class="legend-item">
                                <div class="legend-dot answered"></div>
                                <span>Đã chọn câu trả lời</span>
                            </div>
                            <div class="legend-item">
                                <div class="legend-dot unanswered"></div>
                                <span>Chưa chọn đáp án</span>
                            </div>
                        </div>

                        <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #f1f5f9;">
                            <button type="button" id="btnSubmitQuiz" onclick="handleSubmitQuiz()" class="btn btn-primary-gradient btn-block" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.95rem;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" y1="2" x2="11" y2="13"></line>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                </svg>
                                <span>Nộp bài thi</span>
                            </button>
                            <p style="font-size: 0.72rem; color: #94a3b8; text-align: center; margin-top: 0.5rem;">
                                Hệ thống sẽ chấm điểm tức thời và lưu trữ vào CSDL quiz_db.
                            </p>
                        </div>
                    </div>
                </aside>
            </div>
        </form>

        <script>
        const totalQuestions = <%= questions.length %>;
        let timeRemaining = <%= quiz.time_limit %> * 60; // tính bằng giây
        let timerInterval = null;

        // Chọn đáp án, update UI thẻ radio và thanh tiến trình
        function selectOption(qId, letter) {
            const letters = ['A', 'B', 'C', 'D'];
            letters.forEach(l => {
                const label = document.getElementById(`opt_label_${qId}_${l}`);
                if (label) label.classList.remove('selected');
            });

            const selectedLabel = document.getElementById(`opt_label_${qId}_${letter}`);
            const selectedInput = document.getElementById(`opt_input_${qId}_${letter}`);
            if (selectedLabel) selectedLabel.classList.add('selected');
            if (selectedInput) selectedInput.checked = true;

            // Đánh dấu nút palette bên phải
            const paletteBtn = document.getElementById(`palette_btn_${qId}`);
            if (paletteBtn) paletteBtn.classList.add('answered');

            updateProgress();
        }

        // Cập nhật thanh tiến trình câu hỏi
        function updateProgress() {
            const form = document.getElementById('quizForm');
            const formData = new FormData(form);
            let answered = 0;
            for (let pair of formData.entries()) {
                if (pair[0].startsWith('q_')) answered++;
            }

            const percent = Math.round((answered / totalQuestions) * 100);
            const progText = document.getElementById('progressText');
            const progPercent = document.getElementById('progressPercent');
            const progBar = document.getElementById('progressBar');

            if (progText) progText.textContent = `Tiến độ: ${answered} / ${totalQuestions} câu`;
            if (progPercent) progPercent.textContent = `${percent}%`;
            if (progBar) progBar.style.width = `${percent}%`;
        }

        // Cuộn mượt đến câu hỏi
        function scrollToQuestion(qId) {
            const card = document.getElementById(`q_card_${qId}`);
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.style.borderColor = '#6366f1';
                setTimeout(() => { card.style.borderColor = ''; }, 1000);
            }
        }

        // Đếm ngược thời gian làm bài
        function startTimer() {
            const display = document.getElementById('timerDisplay');
            const widget = document.getElementById('timerWidget');

            timerInterval = setInterval(() => {
                timeRemaining--;
                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    alert('Hết giờ làm bài! Hệ thống tự động nộp bài thi của bạn.');
                    executeSubmit();
                    return;
                }
                const minutes = Math.floor(timeRemaining / 60);
                const seconds = timeRemaining % 60;
                display.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

                // Cảnh báo khi còn dưới 1 phút (đỏ và rung nhẹ)
                if (timeRemaining < 60 && widget) {
                    widget.classList.add('timer-warning');
                }
            }, 1000);
        }

        // Xác nhận nộp bài
        function handleSubmitQuiz() {
            const form = document.getElementById('quizForm');
            const formData = new FormData(form);
            let answered = 0;
            for (let pair of formData.entries()) {
                if (pair[0].startsWith('q_')) answered++;
            }

            if (answered < totalQuestions) {
                const confirmed = confirm(`Bạn mới hoàn thành ${answered}/${totalQuestions} câu hỏi. Bạn có chắc chắn muốn nộp bài thi ngay không?`);
                if (!confirmed) return;
            } else {
                const confirmed = confirm(`Bạn đã hoàn thành đủ ${totalQuestions}/${totalQuestions} câu hỏi. Bạn có chắc chắn muốn nộp bài để chấm điểm?`);
                if (!confirmed) return;
            }

            executeSubmit();
        }

        function executeSubmit() {
            const btn = document.getElementById('btnSubmitQuiz');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>Đang chấm điểm bài thi...</span>';
            }
            if (timerInterval) clearInterval(timerInterval);
            document.getElementById('quizForm').submit();
        }

        document.addEventListener('DOMContentLoaded', () => {
            startTimer();
            updateProgress();
        });
        </script>
    <% } %>
</div>

<%- include('../layouts/footer') %>
