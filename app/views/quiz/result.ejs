<%- include('../layouts/header', { title: 'Kết quả bài thi' }) %>

<div class="container container-sm">
    <div class="result-card">
        <div class="result-header">
            <div class="result-icon <%= result.score >= 5 ? 'result-success' : 'result-fail' %>">
                <%= result.score >= 5 ? '🎉' : '⚠️' %>
            </div>
            <h2>Kết quả làm bài thi</h2>
            <p class="subtitle"><%= result.quiz_title %></p>
        </div>

        <div class="score-display">
            <div class="score-main"><%= result.score %> <span class="score-max">/ 10</span></div>
            <div class="score-status <%= result.score >= 5 ? 'text-success' : 'text-danger' %>">
                <%= result.score >= 5 ? 'ĐẠT (PASSED)' : 'CHƯA ĐẠT (FAILED)' %>
            </div>
        </div>

        <div class="result-details">
            <div class="detail-row">
                <span class="detail-label">Thí sinh:</span>
                <span class="detail-val"><%= result.fullname %> (<%= result.email %>)</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Số câu trả lời đúng:</span>
                <span class="detail-val"><strong><%= result.correct_answers %></strong> / <%= result.total_questions %> câu</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Tỷ lệ chính xác:</span>
                <span class="detail-val"><strong><%= Math.round((result.correct_answers / result.total_questions) * 100) %>%</strong></span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Thời gian nộp bài:</span>
                <span class="detail-val"><%= new Date(result.submitted_at).toLocaleString('vi-VN') %></span>
            </div>
        </div>

        <div class="result-actions">
            <a href="/quizzes/<%= result.quiz_id %>/take" class="btn btn-outline">🔄 Làm lại bài thi</a>
            <a href="/quizzes" class="btn btn-primary">📚 Danh sách đề thi</a>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
